{
  "name": "@codeshark/vat",
  "version": "0.2.0",
  "description": "Offline VAT number validation (format + checksum) for EU and selected other countries",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Codeshark-NET/vat-js.git"
  },
  "homepage": "https://github.com/Codeshark-NET/vat-js#readme",
  "bugs": "https://github.com/Codeshark-NET/vat-js/issues",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.16.1",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "LICENSE.jsvat"
  ],
  "keywords": [
    "vat",
    "vat-number",
    "vatin",
    "jsvat",
    "eu",
    "validation",
    "checksum",
    "tax"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "bench": "node bench/bench.ts",
    "prepack": "pnpm build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^26.6.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{ts,js,json,md}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
